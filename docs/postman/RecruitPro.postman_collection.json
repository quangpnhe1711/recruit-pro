{
  "info": {
    "name": "RecruitPro API",
    "_postman_id": "b1e7c0de-1a2b-4c3d-9e8f-recruitpro0001",
    "description": "RecruitPro recruitment API. Flows: login -> apply -> screening -> offer; OData queries; XML content negotiation; gRPC external score; SysAdmin disable-user. Log in first (Auth folder) to populate {{accessToken}}. Shared password: Password@123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication + token lifecycle. Start here: log in to populate {{accessToken}}/{{refreshToken}}, then run the candidate flow (apply -> screening -> offer) and the HR/SysAdmin flows. Login by username, password Password@123. Demo users: candidate=nhatquang, HR=thucuyen, Manager/Head=tiendat, SystemAdmin=admin.",
      "item": [
        {
          "name": "Candidate Login (nhatquang)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/candidate/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "candidate",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nhatquang\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Candidate portal login. Saves accessToken/refreshToken for the apply -> offer flow."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save tokens from the ApiResponse envelope (data.accessToken / data.refreshToken).",
                  "const d = pm.response.json().data;",
                  "if (d) {",
                  "  pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
