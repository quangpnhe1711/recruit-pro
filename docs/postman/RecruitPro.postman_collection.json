    {
      "name": "OData",
      "description": "OData v4 query endpoints under /odata (separate from /api). Jobs is public (Approved only); Applications is HR/Manager gated. Supports $filter/$orderby/$select/$top/$skip/$count.",
      "item": [
        {
          "name": "OData Jobs ($filter/$top/$orderby/$select)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/odata/Jobs?$filter=contains(Title,'Java')&$top=5&$orderby=CreatedAt desc&$select=Id,Title,Location,Status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "odata",
                "Jobs"
              ],
              "query": [
                {
                  "key": "$filter",
                  "value": "contains(Title,'Java')"
                },
                {
                  "key": "$top",
                  "value": "5"
                },
                {
                  "key": "$orderby",
                  "value": "CreatedAt desc"
                },
                {
                  "key": "$select",
                  "value": "Id,Title,Location,Status"
                }
              ]
            },
            "description": "Composable OData query over the Approved job set."
          },
          "response": []
        },
        {
          "name": "OData Applications ($filter/$select/$orderby)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/odata/Applications?$filter=Status eq 'Interview'&$select=Id,Status,FinalScore&$orderby=AppliedAt desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "odata",
                "Applications"
              ],
              "query": [
                {
                  "key": "$filter",
                  "value": "Status eq 'Interview'"
                },
                {
                  "key": "$select",
                  "value": "Id,Status,FinalScore"
                },
                {
                  "key": "$orderby",
                  "value": "AppliedAt desc"
                }
              ]
            },
            "description": "OData over applications (HR/Manager only)."
          },
          "response": []
        }
      ]
    },
