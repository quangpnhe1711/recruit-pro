{
  "//": "Production secrets MUST be supplied via environment variables, never committed.",
  "//env": "ASP.NET Core maps double-underscore env vars onto config keys. Set these on the host:",
  "//ConnectionStrings__Mycnn": "Host=...;Port=5432;Database=postgres;Username=...;Password=...;SSL Mode=Require;Trust Server Certificate=true",
  "//Jwt__Key": "<a long random secret, >= 32 chars>",
  "//MinioSettings__AccessKey": "<minio access key>",
  "//MinioSettings__SecretKey": "<minio secret key>",
  "//AiProvider__ApiKey": "<gemini api key>",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Mycnn": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "RecruitPro",
    "Audience": "RecruitProUsers",
    "ExpiryMinutes": 360,
    "RefreshTokenExpiryMinutes": 3600
  },
  "MinioSettings": {
    "Endpoint": "storage.railway.app",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "recruitpro",
    "UseSsl": true,
    "BaseUrl": "https://storage.railway.app",
    "PresignedUrlExpiryInSeconds": 3600
  },
  "AiProvider": {
    "Enabled": true,
    "ApiKey": "",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
    "Model": "gemini-3.1-flash-lite",
    "EmbeddingModel": "text-embedding-004",
    "MaxCandidatesForAi": 50,
    "MaxResumeCharsPerCandidate": 6000,
    "MaxResumeParseChars": 12000,
    "RequestTimeoutSeconds": 180
  },
  "Cors": {
    "AllowedOrigins": [
      "https://www.recruitpro.site",
      "https://recruitpro.site"
    ]
  },
  "AllowedHosts": "*"
}
